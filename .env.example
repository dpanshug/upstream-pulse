# Database
DATABASE_URL=postgresql://postgres:password@localhost:5433/upstream_pulse
REDIS_URL=redis://localhost:6379

# CollectOSS / Augur (optional — dual-backend for contribution collection)
# When set, enables CollectOSS as an alternative data source to the GitHub API.
# Projects can be toggled individually between 'github' and 'collectoss' backends.
#
# Local testing with sample data (start with: docker compose --profile collectoss up -d):
# AUGUR_DATABASE_URL=postgresql://sample_user:sample_password@localhost:5434/sample_collected_data
#
# Production (via SSH tunnel to eightknot.osci.io):
# AUGUR_DATABASE_URL=postgresql://user:pass@localhost:5411/collectoss
AUGUR_DATABASE_URL=

# GitHub API
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_ORG=kubernetes

# GitHub org team sync (requires read:org scope to see private members)
# Comma-separated list of GitHub orgs to sync team members from
GITHUB_TEAM_TOKEN=ghp_your_personal_pat_here
GITHUB_TEAM_ORG=your-github-org,another-org

# Insight Generation (optional - Google Gemini)
GOOGLE_AI_API_KEY=AIzaSy_your_google_ai_api_key_here

# Organization
ORG_NAME=My Organization
ORG_DESCRIPTION=Tracking upstream contributions across your portfolio
ORG_DOCS_URL=
TEAM_EMAIL_DOMAIN=example.com

# Application
NODE_ENV=development
PORT=4321
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:4321

# Authorization — comma-separated admin users/groups
# In dev mode (no gateway headers), all users are admin by default
ADMIN_USERS=
ADMIN_GROUPS=

# OpenShift namespace (used by port-forward scripts, defaults to 'upstream-pulse')
# OC_NAMESPACE=upstream-pulse

# Monitoring
PROMETHEUS_ENABLED=true
